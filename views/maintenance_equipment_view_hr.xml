<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="maintenance_equipment_view_form_inherit_hr_equipment_allocations_as_stock"
        model="ir.ui.view">
        <field name="name">maintenance.equipment.view.form.inherit</field>
        <field name="model">maintenance.equipment</field>
        <field name="inherit_id"
            ref="hr_maintenance.maintenance_equipment_view_form_inherit_hr"/>
        <field name="arch"
            type="xml">
            <xpath expr="//field[@name='employee_id']"
                position="replace">
                <field name="employee_ids"
                    widget="many2many_tags"
                    readonly="1"
                    invisible="not employee_ids" />
            </xpath>

            <xpath expr="//field[@name='department_id']"
                position="replace">
                <field name="department_id"
                    string="Department"
                    readonly="1"
                    invisible="1" />
            </xpath>

            <xpath expr="//field[@name='equipment_assign_to']"
                position="replace">
                <field name="equipment_assign_to"
                    widget="badge"
                    readonly="1" />
            </xpath>
        </field>
    </record>

</odoo>
