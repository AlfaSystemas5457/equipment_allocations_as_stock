<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="equipment_allocation_maintenance_equipment_view_kanban_inherit_hr"
        model="ir.ui.view">
        <field name="name">maintenance.equipment.view.kanban.inherit</field>
        <field name="model">maintenance.equipment</field>
        <field name="inherit_id"
            ref="maintenance.hr_equipment_view_kanban"/>
        <field name="arch"
            type="xml">
            <xpath expr="//field[@name='employee_id'][@widget='many2one_avatar_employee']"
                position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//field[@name='department_id']"
                position="replace"/>

            <xpath expr="//field[@name='serial_no']"
                position="after">
                <div t-if="record.employee_ids">Asignado</div>
            </xpath>
        </field>
    </record>

    <record id="equipment_alloc_maintenance_equipment_view_kanban_remove"
        model="ir.ui.view">
        <field name="name">maintenance.equipment.kanban.remove.employee.fields</field>
        <field name="model">maintenance.equipment</field>
        <field name="inherit_id"
            ref="hr_maintenance.maintenance_equipment_view_kanban_inherit_hr"/>
        <field name="arch"
            type="xml">
            <xpath expr="//field[@name='serial_no']/following-sibling::*[position() &lt;= 3]"
                position="replace"/>
        </field>
    </record>

</odoo>
